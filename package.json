{
  "name": "inhabi.co",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:gh": "node scripts/clean.mjs && vite-ssg build --mode github && node scripts/generate-sitemap.mjs",
    "build:s": "node scripts/clean.mjs && vite-ssg build --mode cloudflare && node scripts/generate-sitemap-cloudflare.mjs",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "oxfmt src/"
  },
  "dependencies": {
    "@unhead/vue": "^3.4.2",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/test-utils": "^2.5.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-vue": "~10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.67.0",
    "oxlint": "~1.82.0",
    "sass-embedded": "^1.105.1",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "vite": "^8.2.2",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-ssg": "npm:@oscarcontrola/vite-ssg@^28.3.0",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "allowScripts": {
    "vue-demi@0.14.10": true,
    "@parcel/watcher@2.6.0": true
  }
}
